# SEGREDOS das Edge Functions — ficam no SUPABASE, nunca na Netlify nem no navegador.
# Copie para supabase/functions/.env (ignorado pelo git), preencha e envie com:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são fornecidas automaticamente pelo Supabase.

# ── Mercado Pago (Suas integrações → Credenciais de produção) ──
MP_ACCESS_TOKEN=APP_USR-...
# Suas integrações → Webhooks → "Assinatura secreta". Sem ela o webhook recusa tudo (503).
MP_WEBHOOK_SECRET=

# ── Frete: Melhor Envio (token com permissão shipping-calculate). Sem ele usa a tabela de contingência ──
ME_TOKEN=
# ME_ENV=sandbox

# ── E-mails transacionais: Resend (resend.com → API Keys; domínio verificado) ──
RESEND_API_KEY=re_...
MAIL_FROM=Bodemania <pedidos@bodemania.com.br>
MAIL_REPLY_TO=contato@bodemania.com.br
ADMIN_EMAIL=contato@bodemania.com.br

# ── Loja ──
SITE_URL=https://bodemania.com.br
# CEP de onde saem as encomendas
ORIGIN_CEP=00000000

# Opcionais (valores padrão entre parênteses)
# FREE_SHIPPING_FROM=299      (frete grátis a partir de R$)
# PIX_DISCOUNT=0.05           (5% no Pix)
# MAX_INSTALLMENTS=6
# MIN_INSTALLMENT=30
