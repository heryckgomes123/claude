# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# NUNCA comita arquivo .env.production.local com valores reais!
# Configure essas variáveis no painel Netlify:
# Netlify → Settings → Build & deploy → Environment

# ========================================
# 🌐 PUBLIC VARIABLES (Seguro no navegador)
# ========================================

# URL da loja (seu domínio)
VITE_SITE_URL=https://seudominio.com.br

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...seu_anon_key

# Mercado Pago (Seller Dashboard → Configurações → Credenciais)
# ⚠️ Use APENAS a PUBLIC KEY aqui (começa com APP_USR)
VITE_MP_PUBLIC_KEY=APP_USR_xxx...

# Redes sociais
VITE_INSTAGRAM_URL=https://instagram.com/lojabodemania
VITE_WHATSAPP_NUMBER=67999113636

# Google Analytics (GA4)
# Pega em: Google Analytics → Admin → Propriedade → Dados de stream
VITE_GA_ID=G-XXXXXXXXXX

# ========================================
# ⚠️ SECRET VARIABLES (Nunca exponha!)
# ========================================
# Configure no painel Netlify como variáveis privadas
# Netlify não as expõe ao navegador, apenas ao build/functions

# Supabase Service Role (para Edge Functions)
# ⚠️ CUIDADO: Acesso total ao banco. NUNCA publique!
# Netlify → Settings → Build & deploy → Environment (marcar como "Sensitive")
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...seu_service_role_key

# Mercado Pago Access Token (para criar tokens de pagamento)
# ⚠️ CUIDADO: Pode fazer transações. NUNCA publique!
MERCADO_PAGO_ACCESS_TOKEN=APP_xxx...seu_access_token

# SendGrid API Key (para enviar emails)
# ⚠️ CUIDADO: Pode enviar emails. NUNCA publique!
SENDGRID_API_KEY=SG.xxx...

# Email de notificações (para receber notificações de pedidos)
ADMIN_EMAIL=seu-email@seudominio.com.br

# ========================================
# 🔍 VERIFICAÇÃO DE SEGURANÇA
# ========================================
# Antes de publicar, verifique:

# ✅ Nenhuma chave acima começa com "xxx" (substituir por valores reais)
# ✅ VITE_SUPABASE_ANON_KEY = chave pública (começa com eyJ)
# ✅ VITE_MP_PUBLIC_KEY = apenas pública (APP_USR_)
# ✅ Variáveis secretas MARCADAS como "Sensitive" no Netlify
# ✅ Nenhuma chave service_role ou access_token no .env público
# ✅ .env.production.local está no .gitignore (NUNCA commitar!)

# ========================================
# 🧪 TESTES
# ========================================
# Para testar as variáveis após deploy:
# 1. npm run build → verifica se build compila com .env.production
# 2. Fazer uma compra teste em staging (Mercado Pago sandboxado)
# 3. Verificar email foi enviado via SendGrid
# 4. Verificar pedido aparece no admin

# ========================================
# 📚 REFERÊNCIAS
# ========================================
# Supabase: https://supabase.com/docs/guides/api-keys
# Mercado Pago: https://www.mercadopago.com.br/developers/pt-BR/docs/sdks/js
# SendGrid: https://sendgrid.com/docs/for-developers/sending-email/
# Netlify Env: https://docs.netlify.com/configure-builds/environment-variables/
