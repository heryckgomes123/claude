# ========================================
# VARIÁVEIS DA NETLIFY (Site configuration → Environment variables)
# ========================================
# TODAS são PÚBLICAS: o Vite as embute no JavaScript que vai para o navegador.
# Nenhum segredo entra aqui. Segredos (Mercado Pago, Resend, Melhor Envio)
# ficam no Supabase — veja supabase/functions/.env.example.

# URL da loja (domínio final, sem barra no fim)
VITE_SITE_URL=https://bodemania.com.br

# Supabase (Project Settings → API): Project URL e chave "anon"/"publishable"
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Mercado Pago: apenas a PUBLIC KEY (Credenciais de produção)
VITE_MP_PUBLIC_KEY=APP_USR-...

# Dados da loja
VITE_WHATSAPP_NUMBER=5567999113636
VITE_INSTAGRAM_URL=https://instagram.com/lojabodemania
# CEP de onde saem as encomendas (mesmo do Supabase)
VITE_ORIGIN_CEP=79823030

# Google Analytics 4 (opcional; só carrega se o cliente aceitar cookies)
VITE_GA_ID=

# ========================================
# CHECAGEM ANTES DO DEPLOY
# ========================================
# - VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY preenchidas → loja usa o banco real
#   (vazias → modo demonstração, tudo no navegador, pedidos NÃO chegam a lugar nenhum)
# - NUNCA coloque SUPABASE_SERVICE_ROLE_KEY ou MP_ACCESS_TOKEN na Netlify
