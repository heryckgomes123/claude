{
  "name": "bodemania-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single && node scripts/finalize-single.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "scripts/pg-test.sh start && TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres vitest run; scripts/pg-test.sh stop",
    "check:functions": "for f in create-order mp-webhook shipping-quote admin-order; do deno check supabase/functions/$f/index.ts || exit 1; done",
    "seed:sql": "node scripts/seed-sql.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "framer-motion": "^13.5.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
