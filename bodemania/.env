# Configuração pública da loja (valores não sensíveis).
# Troque pelos dados reais antes de publicar. Crie um .env.local para sobrescrever localmente.

# WhatsApp de atendimento — apenas dígitos, com DDI + DDD (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=5500000000000

# Chave Pix que recebe os pagamentos (e-mail, CPF/CNPJ, telefone +55… ou chave aleatória)
VITE_PIX_KEY=pix@bodemania.com.br

# CEP de onde saem as encomendas (usado no cálculo de frete)
VITE_ORIGIN_CEP=01310100

# URL pública da loja
VITE_SITE_URL=https://bodemania.com.br

# Instagram
VITE_INSTAGRAM_URL=https://instagram.com/bodemania
