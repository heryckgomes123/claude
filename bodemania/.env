# Configuração PÚBLICA da loja (vai para o navegador — nunca coloque senhas/tokens aqui).
# Em produção, defina estas variáveis no painel da Vercel. Segredos ficam em supabase/functions/.env.example.

# ── Dados da loja ──
VITE_WHATSAPP_NUMBER=67999113636
VITE_SITE_URL=https://bodemania.com.br
VITE_INSTAGRAM_URL=https://instagram.com/lojabodemania
VITE_ORIGIN_CEP=01310100

# ── Supabase (Project Settings → API). Vazio = modo demonstração, tudo no navegador ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Mercado Pago: CHAVE PÚBLICA (Public Key) ──
VITE_MP_PUBLIC_KEY=

# ── Opcional: Google Analytics 4 (G-XXXXXXXXXX). Só carrega se o cliente aceitar os cookies ──
VITE_GA_ID=

# Usado só na demonstração (sem Supabase): chave Pix fictícia — nunca recebe dinheiro
VITE_PIX_KEY=demonstracao@bodemania.invalid
