# ─────────────────────────────────────────────────────────────────────────────
# INTELRA AI LAB — variáveis de ambiente
# Local: copie para .env.local. Produção: configure em Netlify → Site configuration
# → Environment variables. Nunca versione valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# [OBRIGATÓRIA · SECRETA] PostgreSQL persistente (Neon/Netlify DB, Supabase, RDS…).
# Em serverless, prefira a URL com pooler (ex.: Neon "-pooler", Supabase porta 6543) + sslmode=require.
DATABASE_URL=postgres://usuario:senha@host:5432/intelra_lab?sslmode=require

# [OBRIGATÓRIA · SECRETA] Chave de assinatura das sessões (mín. 32 caracteres).
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# [RECOMENDADA · PÚBLICA] URL canônica do app, sem barra final (ex.: https://lab.intelra.com.br).
# Na Netlify, se vazia, usamos a variável automática URL. Deploy previews são aceitos via DEPLOY_PRIME_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPCIONAL] Código do plano concedido automaticamente a toda conta nova (ex.: LAB).
# Deixe VAZIO em produção: o acesso deve vir de códigos de acesso ou concessão no admin.
SIGNUP_DEFAULT_PLAN=

# [OPCIONAL] Conexões por instância de função (padrão 5).
DATABASE_POOL_MAX=

# ── Apenas para o script de seed (npm run db:seed), nunca necessário em runtime ──
# Cria (ou promove) o primeiro administrador. Senha com 12+ caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
