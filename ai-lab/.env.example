# ─────────────────────────────────────────────────────────────────────────────
# INTELRA AI LAB — variáveis de ambiente
# Local: copie para .env.local. Produção: configure em Netlify → Site configuration
# → Environment variables. Nunca versione valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# [OBRIGATÓRIA · SECRETA] PostgreSQL persistente (Neon/Netlify DB, Supabase, RDS…).
# Em serverless, prefira a URL com pooler (ex.: Neon "-pooler", Supabase porta 6543) + sslmode=require.
DATABASE_URL=postgres://usuario:senha@host:5432/intelra_lab?sslmode=require

# [OBRIGATÓRIA · SECRETA] Chave de assinatura das sessões (mín. 32 caracteres).
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# [RECOMENDADA] URL canônica do app, sem barra final (ex.: https://lab.intelra.com.br). Lida em runtime.
# É usada nos links dos webhooks mostrados no painel e nos e-mails.
APP_URL=http://localhost:3000

# ── Vendas: liberação automática de acesso ────────────────────────────────────
# [SECRETA] Hotmart → Ferramentas → Webhook: o "Hottok" da sua conta.
HOTMART_HOTTOK=
# [OPCIONAL] Ids dos produtos da Hotmart que liberam o Lab, separados por vírgula. Vazio = qualquer produto.
HOTMART_PRODUCT_IDS=
# [SECRETA] Kiwify → Apps → Webhooks: o token do webhook.
KIWIFY_WEBHOOK_TOKEN=
# [OPCIONAL] Ids dos produtos da Kiwify que liberam o Lab, separados por vírgula. Vazio = qualquer produto.
KIWIFY_PRODUCT_IDS=

# ── E-mails (recomendado em produção) ─────────────────────────────────────────
# Com os dois preenchidos: e-mail de boas-vindas após a compra, confirmação de e-mail no cadastro
# (prova que o e-mail da compra é mesmo do aluno) e "esqueci minha senha".
# [SECRETA] Chave da API da Resend (https://resend.com).
RESEND_API_KEY=
# Remetente verificado na Resend, ex.: INTELRA AI LAB <lab@intelra.com.br>
EMAIL_FROM=

# [OPCIONAL] Conexões por instância de função (padrão 5).
DATABASE_POOL_MAX=

# ── Apenas para o script de seed (npm run db:seed), nunca necessário em runtime ──
# Cria (ou promove) o professor (admin). Senha com 12+ caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
