# ---------------------------------------------------------------------------
# Públicas (prefixo VITE_ = vão para o navegador). Nunca coloque segredos aqui.
# ---------------------------------------------------------------------------

# WhatsApp comercial — só dígitos, com DDI + DDD. Vazio = WhatsApp oculto.
VITE_WHATSAPP_NUMBER=5511912345678

# E-mail público de contato (opcional).
VITE_CONTACT_EMAIL=contato@exemplo.com.br

# URL pública do site.
VITE_SITE_URL=https://intelra.com.br

# Instagram (opcional).
VITE_INSTAGRAM_URL=https://instagram.com/intelra

# ---------------------------------------------------------------------------
# Servidor (somente na Vercel / .env.local). NUNCA use prefixo VITE_ nestas.
# ---------------------------------------------------------------------------

# Projeto Supabase onde os orçamentos são gravados (tabela public.quote_requests).
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role (ou secret key sb_secret_...). Dá acesso total ao banco: só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Texto aleatório longo usado para anonimizar o IP no limite de envios.
QUOTE_IP_SALT=
