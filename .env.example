# ---------------------------------------------------------------
# MIÚDA — Da Toca do Javali · variáveis de ambiente
# Copie para .env (local) ou cadastre em Netlify > Site > Environment variables
# ---------------------------------------------------------------

# Banco PostgreSQL (produção). Netlify DB/Neon define NETLIFY_DATABASE_URL sozinho.
# Sem nenhuma das duas, o app usa PGlite (Postgres embutido): em disco no
# desenvolvimento local e EM MEMÓRIA em serverless (dados temporários — só demo).
DATABASE_URL=
# NETLIFY_DATABASE_URL=

# Segredo para assinar sessões (obrigatório em produção). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Modo de demonstração: habilita "Entrar como Jogador/Admin/Agente/Super Admin"
# na tela de entrada. Use "false" em um lançamento real.
DEMO_MODE=true

# Popular automaticamente com dados de demonstração quando o banco estiver vazio.
SEED_ON_START=true

# Opcionais
# PORT=8787            # porta do servidor local
# PGLITE_DIR=.data/pglite   # onde o PGlite local guarda os dados ("memory" = memória)
# DB_POOL_MAX=5        # conexões por instância com o Postgres
