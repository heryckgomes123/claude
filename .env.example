# ─────────────────────────────────────────────────────────────
# LIFT 2.0 — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o arquivo .env.
# ─────────────────────────────────────────────────────────────

# ── Frontend (expostas ao navegador: prefixo VITE_) ──
# NUNCA coloque segredos em variáveis VITE_*.
VITE_LIFT_NAME="LIFT FITNESS"
VITE_LIFT_WHATSAPP=""
VITE_LIFT_INSTAGRAM=""
VITE_LIFT_LOCATION=""
# "demo" = respostas locais baseadas em regras (sem IA real)
# "api"  = usa o backend em /api/ai/chat (IA real)
VITE_AI_MODE="demo"

# ── Backend (somente servidor — server/) ──
PORT=8787
AI_PROVIDER="anthropic"
# Chave secreta da IA — fica APENAS no servidor.
AI_API_KEY=""
AI_MODEL="claude-opus-5"
# Esforço de raciocínio: low | medium | high
AI_EFFORT="low"
# Aceitar o contexto do aluno enviado pelo app (NÃO verificado).
# Use apenas em desenvolvimento, até existir autenticação + banco.
ALLOW_CLIENT_CONTEXT="false"
# Origem permitida para CORS (ex.: https://app.liftfitness.com.br)
ALLOWED_ORIGIN="http://localhost:5173"
