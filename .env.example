# ─────────────────────────────────────────────────────────────
# R BEAUTY OS — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (servidor). Em produção use a URL "pooled" do provedor
# (Neon, Supabase, Railway...). Nunca use prefixo NEXT_PUBLIC_ aqui.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/rbeauty"

# Fuso horário do salão (agenda, caixa e relatórios). Não é segredo.
NEXT_PUBLIC_APP_TIMEZONE="America/Sao_Paulo"

# Usado apenas por `npm run db:bootstrap` para criar a primeira
# conta OWNER em produção (sem dados de demonstração).
BOOTSTRAP_OWNER_NAME="Proprietária"
BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""

# "true" = o build do Netlify cria os dados DEMO (apenas se o banco estiver vazio)
# e libera seed/reset com NODE_ENV=production. Deixe "false" em produção real.
ALLOW_DEMO_SEED="false"
