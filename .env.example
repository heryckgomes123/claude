# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string. Leave empty in development to use the
# embedded PGlite database stored in ./.data/pglite (zero setup).
DATABASE_URL=
# Set to "true" when your provider requires TLS (e.g. managed Postgres).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ── AI ───────────────────────────────────────────────────
# Optional. With a key, AIVA AI runs on Claude with tool use over your workspace.
# Without it, AIVA uses its built-in local engine (pt-BR NLU + templates).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
AIVA_MODEL=
