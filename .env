# Configuração pública da landing page (valores NÃO sensíveis — vão para o navegador).
# Para segredos e testes locais use .env.local (ignorado pelo git). Modelo completo: .env.example

# WhatsApp comercial — só dígitos, com DDI + DDD (ex.: 5511912345678).
# Vazio = botões de WhatsApp ficam ocultos.
VITE_WHATSAPP_NUMBER=

# E-mail público de contato (opcional; aparece no rodapé).
VITE_CONTACT_EMAIL=

# URL pública do site (canonical, Open Graph, schema.org).
VITE_SITE_URL=https://claude-pied-one.vercel.app

# Perfil do Instagram (vazio = oculto).
VITE_INSTAGRAM_URL=https://instagram.com/intelra
