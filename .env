# Configuração pública da landing page (valores não sensíveis).
# Troque pelos dados reais antes de publicar. Crie um .env.local para sobrescrever localmente.

# WhatsApp comercial — apenas dígitos, com DDI + DDD (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=5500000000000

# URL pública do site (usada em Open Graph, canonical e schema)
VITE_SITE_URL=https://intelra.com.br

# Perfil do Instagram
VITE_INSTAGRAM_URL=https://instagram.com/intelra
