{
  "name": "miuda-toca-do-javali",
  "version": "1.0.0",
  "private": true,
  "description": "MIÚDA® — Da Toca do Javali. Universo de jogos ambientado em uma taverna dark fantasy.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/dev.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "tsx server/dev.ts --serve-static",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "db:reset": "tsx scripts/reset-db.ts",
    "icons": "node scripts/gen-icons.mjs",
    "build:netlify": "npm run build:web && tsx scripts/db-setup.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:schema": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
